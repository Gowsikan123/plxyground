{
  "expo": {
    "name": "PLXYGROUND",
    "slug": "plxyground",
    "version": "2.0.0",
    "scheme": "plxyground",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.basketballnxtion.plxyground",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "PLXYGROUND uses your photo library so you can add photos to your posts and profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://plxyground.vercel.app"
    },
    "primaryColor": "#FF5A1F",
    "description": "PLXYGROUND connects sports creators with brands: share posts, find opportunities, apply and message."
  }
}
