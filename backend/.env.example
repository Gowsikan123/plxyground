PORT=3011
# Neon Postgres connection strings (Neon dashboard → Connection details)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=replace_with_a_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:8081,http://localhost:3012
NODE_ENV=development
# Used only by scripts/seed-admin.js and the smoke/admin tests — never commit real values
ADMIN_EMAIL=
ADMIN_PASSWORD=
